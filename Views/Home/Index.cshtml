<p id="errorMessage" style="color:red;"></p>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    const symbols = [
        "BTCUSDT",
        "ETHUSDT",
        "BNBUSDT"
    ];

    let connection = null;

    const lastPrices = {};
    const priceHistories = {};

    for (const symbol of symbols) {
        lastPrices[symbol] = null;
        priceHistories[symbol] = [];
    }

    document
        .getElementById("startBtn")
        .addEventListener("click", startListening);

    document
        .getElementById("stopBtn")
        .addEventListener("click", stopListening);

    async function startListening() {
        const errorElement =
            document.getElementById("errorMessage");

        errorElement.textContent = "";
        resetAllPriceStates();

        if (connection) {
            await connection.stop();
        }

        connection = new signalR.HubConnectionBuilder()
            .withUrl("/cryptoHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceivePrice", data => {
            /*
             * Vì C# sử dụng các property:
             * Symbol, Price, Quantity, TradeTime
             *
             * SignalR mặc định chuyển thành:
             * symbol, price, quantity, tradeTime
             */
            console.log(data);

            const symbol =
                data.s?.toUpperCase();

            if (!symbol || !symbols.includes(symbol)) {
                return;
            }

            updatePriceDisplay(symbol, data);
        });

        connection.onreconnecting(() => {
            updateStatus(
                "Đang kết nối lại...",
                "orange"
            );
        });

        connection.onreconnected(() => {
            updateStatus(
                "Đã kết nối",
                "green"
            );
        });

        connection.onclose(() => {
            updateStatus(
                "Ngắt kết nối",
                "red"
            );

            updateButtons(false);
        });

        try {
            await connection.start();

            updateStatus(
                "Đã kết nối",
                "green"
            );

            updateButtons(true);
        } catch (error) {
            updateStatus(
                "Lỗi kết nối",
                "red"
            );

            errorElement.textContent =
                "Không thể kết nối đến server: " +
                error;
        }
    }

    async function stopListening() {
        if (connection) {
            await connection.stop();
            connection = null;
        }

        updateStatus(
            "Chưa kết nối",
            "red"
        );

        updateButtons(false);
    }

    function updatePriceDisplay(symbol, data) {
        const priceElement =
            document.getElementById(
                `price-${symbol}`
            );

        const quantityElement =
            document.getElementById(
                `quantity-${symbol}`
            );

        const timeElement =
            document.getElementById(
                `time-${symbol}`
            );

        if (
            !priceElement ||
            !quantityElement ||
            !timeElement
        ) {
            return;
        }

        const priceValue = Number(data.p);
        const quantityValue =
            Number(data.q ?? 0);

        if (Number.isNaN(priceValue)) {
            return;
        }

        updatePriceDirection(
            symbol,
            priceValue,
            priceElement
        );

        priceElement.textContent =
            formatPrice(priceValue);

        quantityElement.textContent =
            quantityValue.toLocaleString(
                "vi-VN",
                {
                    maximumFractionDigits: 8
                }
            );

        const tradeTime =
            getTradeDate(data.tradeTime);

        timeElement.textContent =
            tradeTime.toLocaleString("vi-VN");

        addPriceHistory(
            symbol,
            priceValue,
            tradeTime
        );
    }

    function updatePriceDirection(
        symbol,
        newPrice,
        priceElement
    ) {
        const previousPrice =
            lastPrices[symbol];

        priceElement.classList.remove(
            "price-up",
            "price-down"
        );

        if (previousPrice !== null) {
            if (newPrice > previousPrice) {
                priceElement.classList.add(
                    "price-up"
                );
            } else if (newPrice < previousPrice) {
                priceElement.classList.add(
                    "price-down"
                );
            }
        }

        lastPrices[symbol] = newPrice;
    }

    function addPriceHistory(
        symbol,
        price,
        time
    ) {
        priceHistories[symbol].unshift({
            price,
            time
        });

        priceHistories[symbol] =
            priceHistories[symbol].slice(0, 10);

        renderPriceHistory(symbol);
    }

    function renderPriceHistory(symbol) {
        const list =
            document.getElementById(
                `history-${symbol}`
            );

        const history =
            priceHistories[symbol];

        if (!list) {
            return;
        }

        if (history.length === 0) {
            list.innerHTML =
                "<li>Chưa có dữ liệu</li>";

            return;
        }

        list.innerHTML = history
            .map(item => {
                return `
                    <li>
                        ${item.time.toLocaleString("vi-VN")}
                        —
                        ${formatPrice(item.price)}
                    </li>
                `;
            })
            .join("");
    }

    function resetAllPriceStates() {
        for (const symbol of symbols) {
            lastPrices[symbol] = null;
            priceHistories[symbol] = [];

            const priceElement =
                document.getElementById(
                    `price-${symbol}`
                );

            const quantityElement =
                document.getElementById(
                    `quantity-${symbol}`
                );

            const timeElement =
                document.getElementById(
                    `time-${symbol}`
                );

            if (priceElement) {
                priceElement.textContent = "---";

                priceElement.classList.remove(
                    "price-up",
                    "price-down"
                );
            }

            if (quantityElement) {
                quantityElement.textContent = "---";
            }

            if (timeElement) {
                timeElement.textContent = "---";
            }

            renderPriceHistory(symbol);
        }
    }

    function getTradeDate(tradeTime) {
        /*
         * Binance gửi Unix timestamp
         * theo milliseconds.
         */
        const timestamp = Number(tradeTime);

        if (Number.isNaN(timestamp)) {
            return new Date();
        }

        return new Date(timestamp);
    }

    function updateStatus(text, color) {
        const statusElement =
            document.getElementById(
                "statusText"
            );

        const connectionStatus =
            document.getElementById(
                "connectionStatus"
            );

        statusElement.textContent = text;
        connectionStatus.style.color = color;
    }

    function updateButtons(isListening) {
        document.getElementById(
            "startBtn"
        ).style.display =
            isListening
                ? "none"
                : "inline-block";

        document.getElementById(
            "stopBtn"
        ).style.display =
            isListening
                ? "inline-block"
                : "none";
    }

    function formatPrice(price) {
        const number = Number(price);

        if (Number.isNaN(number)) {
            return price;
        }

        return new Intl.NumberFormat(
            "vi-VN",
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 8
            }
        ).format(number) + " USDT";
    }

    window.addEventListener(
        "beforeunload",
        () => {
            if (connection) {
                connection.stop();
            }
        }
    );

    async function GetRSI15m(){
        try {
        const responsebtc = await fetch("/home/analysis?symbol=btcusdt&interval=15m");
        const responseeth = await fetch("/home/analysis?symbol=ethusdt&interval=15m");
        const responsebnb = await fetch("/home/analysis?symbol=bnbusdt&interval=15m");

        const btcdata = await responsebtc.json();
        const ethdata = await responseeth.json();
        const bnbdata = await responsebnb.json();

        const btcElement = document.getElementById("rsi-BTCUSDT-15m");
        const ethElement = document.getElementById("rsi-ETHUSDT-15m");
        const bnbElement = document.getElementById("rsi-BNBUSDT-15m");

        btcElement.textContent = btcdata;
        ethElement.textContent = ethdata;
        bnbElement.textContent = bnbdata;

    } catch (err) {
        console.error(err);
    }

    setTimeout(GetRSI15m, 5000);
    }

